#openia model (later will be enabled)
OPENAI_API_KEY=sk-...

#free models
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=AQ...

# Optional local model provisioned by Ollama on the host and routed through OmniRoute.
# Leave blank to skip local inference; use a model suited to the host resources.
OLLAMA_MODEL=qwen3.5:4b
# Provisioning writes the verified Free-first fallback combo here.
AUTO_CHAT_MODEL=superharry-auto

SUPERHARRY_GMAIL_ACCOUNT=you@example.com
